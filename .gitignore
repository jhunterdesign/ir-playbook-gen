# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment / secrets — never commit real values
.env
*.pem
*.key
secrets/

# Logs, captures, scan output, wordlists you don't want in git
logs/*
!logs/.gitkeep
data/*
!data/.gitkeep
*.log
*.pcap
*.pcapng

# Build / packaging
build/
dist/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Coverage
.coverage
htmlcov/

# Playbooks
playbooks/